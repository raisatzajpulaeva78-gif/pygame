import pygame
import random

# Инициализация
pygame.init()

# Настройки экрана
WIDTH, HEIGHT = 800, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Coin Collector Pro")

# Цвета
WHITE = (255, 255, 255)
GOLD = (255, 215, 0)
BLUE = (30, 144, 255)
RED = (220, 20, 60)
BLACK = (0, 0, 0)

# Шрифты
font_main = pygame.font.SysFont("Arial", 32)
font_big = pygame.font.SysFont("Arial", 64)

def run_game():
    # Параметры игрока
    player = pygame.Rect(WIDTH // 2, HEIGHT - 70, 50, 50)
    player_speed = 8

    # Параметры объектов
    coin = pygame.Rect(random.randint(0, WIDTH - 30), -100, 30, 30)
    enemy = pygame.Rect(random.randint(0, WIDTH - 40), -200, 40, 40)
    
    coin_speed = 5
    enemy_speed = 6
    score = 0
    
    clock = pygame.time.Clock()
    game_over = False
    running = True

    while running:
        screen.fill(WHITE)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return False # Выход из программы
            
            if event.type == pygame.KEYDOWN:
                if game_over and event.key == pygame.K_r:
                    return True # Перезапуск

        if not game_over:
            # Управление
            keys = pygame.key.get_pressed()
            if keys[pygame.K_LEFT] and player.left > 0:
                player.x -= player_speed
            if keys[pygame.K_RIGHT] and player.right < WIDTH:
                player.x += player_speed

            # Движение объектов
            coin.y += coin_speed
            enemy.y += enemy_speed

            # Возврат монеты
            if coin.top > HEIGHT:
                coin.x = random.randint(0, WIDTH - coin.width)
                coin.y = -coin.height

            # Возврат врага и усложнение
            if enemy.top > HEIGHT:
                enemy.x = random.randint(0, WIDTH - enemy.width)
                enemy.y = -enemy.height
                enemy_speed += 0.2

            # Столкновения
            if player.colliderect(coin):
                score += 1
                coin.x = random.randint(0, WIDTH - coin.width)
                coin.y = -coin.height
                if score % 5 == 0: # Каждые 5 монет чуть ускоряем всё
                    coin_speed += 0.5

            if player.colliderect(enemy):
                game_over = True

        # Отрисовка
        pygame.draw.rect(screen, BLUE, player)
        pygame.draw.ellipse(screen, GOLD, coin) # Эллипс выглядит как монета
        pygame.draw.rect(screen, RED, enemy)

        # Интерфейс
        score_text = font_main.render(f"Счет: {score}", True, BLACK)
        screen.blit(score_text, (10, 10))

        if game_over:
            # Затемнение экрана при проигрыше
            overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            overlay.fill((255, 255, 255, 150))
            screen.blit(overlay, (0,0))
            
            msg = font_big.render("ИГРА ОКОНЧЕНА", True, RED)
            retry_msg = font_main.render("Нажмите 'R' для перезапуска", True, BLACK)
            
            screen.blit(msg, (WIDTH//2 - 200, HEIGHT//2 - 50))
            screen.blit(retry_msg, (WIDTH//2 - 180, HEIGHT//2 + 30))

        pygame.display.flip()
        clock.tick(60)

# Запуск игры с возможностью перезапуска
playing = True
while playing:
    playing = run_game()

pygame.quit()
